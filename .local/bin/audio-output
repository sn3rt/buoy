#!/usr/bin/env bash
set -euo pipefail

laptop_card='alsa_card.pci-0000_00_1f.3-platform-skl_hda_dsp_generic'
laptop_profile='HiFi (HDMI1, HDMI2, HDMI3, Mic1, Mic2, Speaker)'
laptop_sink='alsa_output.pci-0000_00_1f.3-platform-skl_hda_dsp_generic.HiFi__Speaker__sink'
dock_sink='alsa_output.usb-Lenovo_ThinkPad_USB-C_Dock_Audio_000000000000-00.analog-stereo'

usage() {
  printf 'usage: audio-output {laptop|dock|toggle|status}\n' >&2
}

die() {
  printf 'audio-output: %s\n' "$*" >&2
  exit 1
}

require_pactl() {
  command -v pactl >/dev/null 2>&1 \
    || die 'pactl not found; install pipewire-pulse'
}

sink_exists() {
  local wanted="$1"
  pactl list short sinks | awk -v wanted="$wanted" '$2 == wanted { found=1 } END { exit !found }'
}

move_playback() {
  local sink="$1" input_id

  while read -r input_id _; do
    [[ -n "$input_id" ]] || continue
    pactl move-sink-input "$input_id" "$sink" >/dev/null 2>&1 || true
  done < <(pactl list short sink-inputs)
}

select_sink() {
  local label="$1" sink="$2"

  sink_exists "$sink" || die "$label output is not available"
  pactl set-default-sink "$sink"
  move_playback "$sink"
  printf 'audio-output: using %s\n' "$label"
}

select_laptop() {
  pactl set-card-profile "$laptop_card" "$laptop_profile" \
    || die 'could not activate the laptop Speaker profile'
  select_sink laptop "$laptop_sink"
}

show_status() {
  local current
  current="$(pactl get-default-sink)"

  case "$current" in
    "$laptop_sink") printf 'laptop\n' ;;
    "$dock_sink") printf 'dock\n' ;;
    *) printf '%s\n' "$current" ;;
  esac
}

main() {
  require_pactl

  case "${1-}" in
    laptop) select_laptop ;;
    dock) select_sink dock "$dock_sink" ;;
    toggle)
      if [[ "$(pactl get-default-sink)" == "$dock_sink" ]]; then
        select_laptop
      else
        select_sink dock "$dock_sink"
      fi
      ;;
    status) show_status ;;
    -h|--help) usage ;;
    *)
      usage
      exit 2
      ;;
  esac
}

main "$@"
